# .env
# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

# Change this url to your domain name
SERVER_NAME="http://localhost"
###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN="*"
###< nelmio/cors-bundle ###

IMAGES_PREFIX="lolsauce-"

###> symfony/framework-bundle ###
APP_SECRET="YourSecretAppKey"
###< symfony/framework-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_PASSPHRASE="DEV_PASS_PHRASE"
###< lexik/jwt-authentication-bundle ###

CADDY_GLOBAL_OPTIONS="auto_https off"

###> You probably don't need to change these keys because they probably automatically adapt to your upward variables, or from the overwriten .env.prod variables

# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_PUBLIC_URL="${SERVER_NAME:-localhost}/.well-known/mercure"

FRANKENPHP_WORKER_CONFIG="watch"
VITE_SERVER_NAME="${SERVER_NAME}:5173"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

###> Mercure
MERCURE_URL=http://localhost:80/.well-known/mercure
MERCURE_JWT_SECRET="key_file ${JWT_SECRET_KEY}"
MERCURE_PUBLISHER_JWT_KEY="key_file ${JWT_SECRET_KEY}"
MERCURE_SUBSCRIBER_JWT_KEY="key_file ${JWT_PUBLIC_KEY}"
MERCURE_EXTRA_DIRECTIVES=demo
MERCURE_JWT_ALG="RS256"
###< Mercure

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
MYSQL_USER="your_mysql_username"
MYSQL_PASSWORD="your_production_mysql_password"
MYSQL_ROOT_PASSWORD="your_production_root_password"
MYSQL_DATABASE="your_production_db"
DATABASE_URL="mysql://${MYSQL_USER:-app}:${MYSQL_PASSWORD:-!ChangeMe!}@${MYSQL_IP:-database}:3306/${MYSQL_DATABASE:-app}?serverVersion=${MYSQL_VERSION:-8}&charset=${MYSQL_CHARSET:-utf8mb4}"
###< doctrine/doctrine-bundle ###

